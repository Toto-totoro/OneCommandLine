{
    "name": "onecommandline",
    "version": "0.0.5",
    "description": "A simple command line.<br> \r Press one <code>customizable</code> button to open up a small one line window that supports simple commands:<br>\r - <code>br [value]</code> - set the brightness of your monitor\r - <code>settings</code> - opens up the settings menu",
    "main": "main.js",
    "build": {
        "appId": "com.phantomica.onecommandline"
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "electron .",
        "pack": "electron-builder --dir",
        "dist": "electron-builder"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/phantomica/OneCommandLine.git"
    },
    "author": "phantomica",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/phantomica/OneCommandLine/issues"
    },
    "homepage": "https://github.com/phantomica/OneCommandLine#readme",
    "devDependencies": {
        "electron": "^26.0.0"
    },
    "dependencies": {
        "brightness": "^3.0.0",
        "find-process": "^1.4.7",
        "loudness": "^0.4.1",
        "node-powershell": "^5.0.1",
        "require-all": "^3.0.0",
        "sudo-prompt": "^9.2.1",
        "wmi-client": "^0.5.0"
    }
}
